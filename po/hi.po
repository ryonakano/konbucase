#: src/widget/kc-tool-bar.c:338
msgid "Space separated"
msgstr "रिक्ति से अलग"

#: src/widget/kc-tool-bar.c:339
msgid "Each word is separated by a space"
msgstr "प्रत्येक शब्द को एक रिक्त स्थान द्वारा अलग किया गया है"

#: src/widget/kc-tool-bar.c:343
msgid "The first character of compound words is in lowercase"
msgstr "संयुक्त शब्दों का पहला अक्षर छोटे अक्षरों में होता है"

#: src/widget/kc-tool-bar.c:347
msgid "The first character of compound words is in uppercase"
msgstr "संयुक्त शब्दों का पहला अक्षर बड़े अक्षरों में होता है"

#: src/widget/kc-tool-bar.c:351
msgid "Each word is separated by an underscore"
msgstr "प्रत्येक शब्द को एक अधोरेखा द्वारा अलग किया गया है"

#: src/widget/kc-tool-bar.c:355
msgid "Each word is separated by a hyphen"
msgstr "प्रत्येक शब्द को समास-चिह्न द्वारा अलग किया गया है"

#: src/widget/kc-tool-bar.c:359
msgid "The first character of the first word in the sentence is in uppercase"
msgstr "वाक्य में पहले शब्द का पहला अक्षर बड़े अक्षरों में है"

#: src/widget/kc-tool-bar.c:384
msgid "Copy to Clipboard"
msgstr "क्लिपबोर्ड पर कॉपी करें"
