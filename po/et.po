msgid "Space separated"
msgstr "Tühikutega eraldatud"

#: src/widget/kc-tool-bar.c:339
msgid "Each word is separated by a space"
msgstr "Sõnu eraldavad tühikud"

#: src/widget/kc-tool-bar.c:343
msgid "The first character of compound words is in lowercase"
msgstr "Liitsõna esimene sõna algab väiketähega"

#: src/widget/kc-tool-bar.c:347
