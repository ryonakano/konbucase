#: data/konbucase.desktop.in.in:2
msgid "@APP_NAME@"
msgstr "@APP_NAME@"

#: data/konbucase.desktop.in.in:3
msgid "Case Converting App"
msgstr "Suur- ja väiketähtede konverteerija"

#: data/konbucase.desktop.in.in:4 data/konbucase.metainfo.xml.in.in:11
msgid "Convert case in your text"
msgstr ""
"Konverteeri soovitud tekstis suur- ja väiketähti ning tühikuid ja kriipse"

#: data/konbucase.desktop.in.in:10
msgid "Text;"
msgstr "tekst;suurtäht;suurtähed;väiketäht;väiketähed;konverteerija;konverteerimine;"

#: data/konbucase.metainfo.xml.in.in:13
msgid "A small text tool app that allows you convert case in your text."
msgstr ""
"Lihtne tekstitarvik, mis konverteerib soovitud tekstis suur- ja väiketähti "
"ning tühikuid ja kriipse."

#: data/konbucase.metainfo.xml.in.in:16
msgid "Features include:"
msgstr "Funktsionaalsused:"

#: data/konbucase.metainfo.xml.in.in:18
msgid ""
"Click \"Copy to Clipboard\" button to copy the all texts in the text view "
"without selecting them"
msgstr "Teksti kopeerimine lõikelauale ilma teksti valimata"

#: data/konbucase.metainfo.xml.in.in:19
msgid "Click \"Quick Swap\" button to swap case and text of input and output"
msgstr ""
"Sisendi ja väljundi suur- ja väiketähtede vahetamiseks klõpsa nuppu "
"„Kiirvahetus“"

#: data/konbucase.metainfo.xml.in.in:20
msgid ""
"Convert your text between camelCase, PascalCase, Sentence case, snake_case, "
"kebab-case, and space-separated"
msgstr ""
"Kopeeri teksti erinevate kombinatsioonide vahel: kaameliTähed (camelCase), "
"PascaliTähed (PascalCase), Tavalause (Sentence case), mao_tähed "
"(snake_case), kebabi-tähed (kebab-case) ja sõnade eraldamine tühikutega"

#: data/konbucase.metainfo.xml.in.in:26
msgid "App window in the light mode"
msgstr "Heledas kujunduses rakenduse aken"

#: data/konbucase.metainfo.xml.in.in:31
msgid "App window in the dark mode"
msgstr "Tumedas kujunduses rakenduse aken"

#: data/ui/help-overlay.blp:10
msgctxt "shortcut window"
msgid "General"
msgstr "Üldised seadistused"

#: data/ui/help-overlay.blp:14
msgctxt "shortcut window"
msgid "Keyboard Shortcuts"
msgstr "Klaviatuuri kiirklahvid"

#: data/ui/help-overlay.blp:19
msgctxt "shortcut window"
msgid "Quit"
msgstr "Välju"

