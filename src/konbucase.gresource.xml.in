<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/com/github/ryonakano/konbucase">
    <file alias="Application.css">../data/Application.css</file>

    <file preprocess="xml-stripblanks" alias="gtk/help-overlay.ui">help-overlay.ui</file>
    <file preprocess="xml-stripblanks">view/kc-main-view.ui</file>
    <file preprocess="xml-stripblanks">kc-main-window.ui</file>

    <file preprocess="xml-stripblanks" alias="@APP_ID@.metainfo.xml">../data/@APP_ID@.metainfo.xml</file>
  </gresource>
</gresources>
